{
  "name": "restitution_app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.config.json",
    "build": "ng build --prod --base-href /restwebforms/ --deploy-url /restwebforms/",
    "builduat": "ng build --prod --base-href /uat/restwebforms/ --deploy-url /uat/restwebforms/",
    "watch": "ng build --watch --base-href /restwebforms/ --deploy-url /restwebforms/",
    "build:ssr": "npm run build -- --app=ssr --output-hashing=media",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "9.1.13",
    "@angular/cdk": "^9.2.4",
    "@angular/common": "9.1.13",
    "@angular/compiler": "9.1.13",
    "@angular/core": "9.1.13",
    "@angular/forms": "9.1.13",
    "@angular/material": "^9.2.4",
    "@angular/material-moment-adapter": "^9.2.4",
    "@angular/platform-browser": "9.1.13",
    "@angular/platform-browser-dynamic": "9.1.13",
    "@angular/platform-server": "9.1.13",
    "@angular/router": "9.1.13",
    "@types/lodash": "^4.14.157",
    "bootstrap": "^4.3.1",
    "core-js": "^2.4.1",
    "hammerjs": "^2.0.8",
    "lodash": "^4.17.21",
    "moment": "^2.22.2",
    "moment-timezone": "^0.5.46",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ng-busy": "^7.0.0",
    "ngx-bootstrap": "^5.6.2",
    "ngx-cookie-service": "^2.1.0",
    "ngx-file-drop": "^5.0.0",
    "ngx-mask": "^8.1.7",
    "node-sass": "^4.13.1",
    "rxjs": "^6.3.3",
    "web-animations-js": "^2.3.1",
    "webpack": "^4.28.3",
    "webpack-dev-server": "^3.11.2",
    "zone.js": "~0.10.3"
