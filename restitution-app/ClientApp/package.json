{
  "name": "restitution_app",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.config.json",
    "build": "ng build --prod --base-href /restwebforms/ --deploy-url /restwebforms/",
    "builduat": "ng build --prod --base-href /uat/restwebforms/ --deploy-url /uat/restwebforms/",
    "watch": "ng build --watch --base-href /restwebforms/ --deploy-url /restwebforms/",
    "build:ssr": "npm run build -- --app=ssr --output-hashing=media",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "10.2.5",
    "@angular/cdk": "^10.2.5",
    "@angular/common": "10.2.5",
    "@angular/compiler": "10.2.5",
    "@angular/core": "10.2.5",
    "@angular/forms": "10.2.5",
    "@angular/material": "^10.2.5",
    "@angular/material-moment-adapter": "^10.2.5",
    "@angular/platform-browser": "10.2.5",
    "@angular/platform-browser-dynamic": "10.2.5",
    "@angular/platform-server": "10.2.5",
    "@angular/router": "10.2.5",
    "bootstrap": "^5.3.8",
    "moment": "^2.22.2",
    "moment-timezone": "^0.5.46",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-bootstrap": "6.2.0",
    "ngx-cookie-service": "^2.1.0",
    "ngx-file-drop": "^10.1.1",
    "ngx-mask": "^10.0.4",
    "rxjs": "^6.3.3",
    "webpack": "^4.28.3",
    "webpack-dev-server": "^3.11.2",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1002.4",
    "@angular/cli": "^10.2.4",
    "@angular/compiler-cli": "~10.2.5",
    "@angular/language-service": "~10.2.5",
    "@types/jasmine": "~2.8.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~8.9.4",
    "jasmine-core": "~2.99.1",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "^6.3.18",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~1.1.2",
    "karma-jasmine-html-reporter": "^0.2.2",
    "mini-css-extract-plugin": "^0.5.0",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^4.1.0",
    "protractor": "~5.4.0",
    "ts-node": "~7.0.0",
    "tslint": "~5.11.0",
    "typescript": "~4.0.8"
  }
}
