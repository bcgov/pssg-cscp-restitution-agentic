    "karma-jasmine-html-reporter": "^0.2.2",
    "mini-css-extract-plugin": "^0.5.0",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^4.1.0",
    "protractor": "~5.4.0",
    "ts-node": "~7.0.0",
