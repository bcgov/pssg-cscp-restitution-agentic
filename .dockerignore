node_modules/
npm-debug.log*
*.tgz
.angular/

# .NET build artifacts
bin/
obj/
*.user
*.suo
*.userprefs

# Environment and config files (keep specific ones needed for Docker build)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test coverage and test files
coverage/
**/e2e/
**/*.spec.ts
**/*.spec.js
karma.conf.js
protractor.conf.js

